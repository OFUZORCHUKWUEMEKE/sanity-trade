# Shared
NODE_ENV=development
LOG_LEVEL=info
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sanity-trade?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# apps/ingest
INGEST_PORT=3001
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
HEARTBEAT_TIMEOUT_MS=30000
RECONNECT_BASE_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=30000
TRACKED_MINT_TTL_MS=600000
DEDUP_TTL_SECONDS=600
STATS_INTERVAL_MS=60000
REDIS_EVENTS_STREAM=memebot:events

# apps/engine
ENGINE_PORT=3002
PAPER_MODE=true
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1
RATE_LIMIT_DELAY_MS=250
SCORE_T60_MS=60000
SCORE_T5MIN_MS=300000
ENTRY_SCORE_THRESHOLD=70
POSITION_SIZE_SOL=0.1
MAX_CONCURRENT_POSITIONS=3
TAKE_PROFIT_MULTIPLE=2
TAKE_PROFIT_SELL_FRACTION=0.5
TRAILING_STOP_PERCENT=0.2
MARKET_CAP_COLLAPSE_DRAWDOWN=0.6
PLATFORM_FEE_BPS=125
SLIPPAGE_BPS=100
PRIORITY_FEE_SOL=0.0005
CONTROL_STATE_TTL_MS=5000

# apps/notifier
NOTIFIER_PORT=3003
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_SUMMARY_HOUR_UTC=9
COMMAND_POLL_TIMEOUT_SECONDS=30

# apps/analysis
EXIT_GATE_MIN_SIGNALS=100
EXIT_GATE_MIN_DAYS=14
REPORT_OUTPUT_PATH=analysis-report.md
